{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boras-boutique",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boras-boutique-db",
      // Replace with the real id from `npx wrangler d1 create boras-boutique-db`
      // before the first remote deploy; local dev/preview ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "boras-boutique"
    }
  ]
}
